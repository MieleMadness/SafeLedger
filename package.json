{
  "name": "safe-ledger",
  "productName": "SafeLedger",
  "version": "2.0.45",
  "description": "Free, offline and portable encrypted information vault",
  "main": "src/main/main.js",
  "scripts": {
    "prepare:icons": "node scripts/prepare-token-assets.js",
    "start": "npm run prepare:icons && electron .",
    "test:regression": "node scripts/regression-tests.js && node scripts/crypto-v3-tests.js && node scripts/ui-regression-tests.js && node scripts/edit-grid-regression-tests.js && node scripts/brute-force-regression-tests.js && node scripts/lockout-regression-tests.js",
    "test:electron-crypto": "node scripts/run-electron-crypto-smoke.js",
    "dist:win": "npm run prepare:icons && electron-builder --win portable --publish never",
    "dist:linux": "npm run prepare:icons && electron-builder --linux AppImage --publish never",
    "dist:dir": "npm run prepare:icons && electron-builder --dir --publish never"
  },
  "repository": "https://github.com/MieleMadness/SafeLedger",
  "keywords": [
    "Electron",
    "SafeLedger",
    "portable",
    "offline",
    "encrypted-vault"
  ],
  "author": "SafeLedger contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@web3icons/core": "4.0.55",
    "electron": "43.4.0",
    "electron-builder": "26.15.7"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "bootstrap": "3.4.1",
    "font-awesome": "4.7.0",
    "hash-wasm": "4.12.0",
    "jquery": "3.7.1",
    "qrcode": "1.5.4"
  },
  "build": {
    "appId": "com.safeledger.app",
    "productName": "SafeLedger",
    "asar": true,
    "files": [
      "src/**/*",
      "build/icon-source.png",
      "sl.png",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "build/icon-source.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SafeLedger-${version}-Portable.${ext}"
    },
    "linux": {
      "icon": "build/icon-source.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SafeLedger-${version}-x86_64.${ext}"
    }
  }
}
