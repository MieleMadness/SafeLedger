{
  "name": "safe-ledger",
  "productName": "SafeLedger",
  "version": "2.6.114",
  "description": "Free, offline and portable encrypted information vault",
  "main": "src/main/bootstrap.js",
  "scripts": {
    "prepare:icons": "node scripts/prepare-token-assets.js",
    "prepare:renderer": "node scripts/build-renderer.js",
    "start": "npm run prepare:icons && npm run prepare:renderer && electron .",
    "test:regression": "npm run prepare:icons && npm run prepare:renderer && node scripts/run-regression-suite.js && node scripts/navigation-relogin-regression-tests.js",
    "test:architecture": "node scripts/test-architecture-tests.js",
    "test:current-product-contract": "node scripts/current-product-contract-tests.js",
    "test:main-process-ownership": "node scripts/main-process-ownership-tests.js",
    "test:renderer-architecture": "node scripts/renderer-architecture-tests.js",
    "audit:dead-code": "node scripts/dead-code-audit.js",
    "audit:css-ownership": "node scripts/css-ownership-audit.js",
    "audit:important-ownership": "node scripts/important-ownership-audit.js",
    "test:runtime-modernization": "node scripts/runtime-modernization-tests.js",
    "test:device-security": "node scripts/device-security-tests.js && node scripts/device-dashboard-health-tests.js && node scripts/navigation-relogin-regression-tests.js",
    "test:recovery-intelligence": "node scripts/recovery-intelligence-tests.js && node scripts/recovery-intelligence-ui-tests.js",
    "test:recovery-command-center": "node scripts/recovery-command-center-tests.js && node scripts/duplicate-asset-authoritative-tests.js",
    "test:startup-performance": "npm run prepare:icons && npm run prepare:renderer && node scripts/startup-performance-tests.js",
    "test:distribution-trust": "node scripts/distribution-trust-tests.js",
    "test:behavioral-lifecycle": "node scripts/behavioral-lifecycle-tests.js",
    "test:release-trust": "node scripts/release-trust-tests.js",
    "test:release-contract": "node scripts/release-trust-contract-tests.js",
    "release:trust": "node scripts/generate-release-trust.js",
    "test:electron-crypto": "node scripts/run-electron-crypto-smoke.js",
    "test:gui-smoke": "npm run prepare:renderer && node scripts/run-gui-smoke.js",
    "docs:pdf": "electron scripts/readme-to-pdf.js",
    "dist:win": "npm run prepare:icons && npm run prepare:renderer && electron-builder --win portable --publish never",
    "dist:linux": "npm run prepare:icons && npm run prepare:renderer && electron-builder --linux AppImage --publish never",
    "dist:mac:arm64": "npm run prepare:icons && npm run prepare:renderer && electron-builder --mac zip --arm64 --publish never",
    "dist:dir": "npm run prepare:icons && npm run prepare:renderer && electron-builder --dir --publish never"
  },
  "repository": "https://github.com/MieleMadness/SafeLedger",
  "keywords": [
    "Electron",
    "SafeLedger",
    "portable",
    "offline",
    "encrypted-vault"
  ],
  "author": "SafeLedger contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@web3icons/core": "4.0.55",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "esbuild": "0.28.2",
    "marked": "12.0.2"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "qrcode": "1.5.4"
  },
  "build": {
    "appId": "com.safeledger.app",
    "productName": "SafeLedger",
    "asar": true,
    "files": [
      "src/**/*",
      "sl.png",
      "LICENSE",
      "NOTICE",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "sl.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SafeLedger-${version}-Portable.${ext}"
    },
    "linux": {
      "icon": "sl.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SafeLedger-${version}-x86_64.${ext}"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "SafeLedger-${version}-macOS-arm64.${ext}"
    }
  }
}
