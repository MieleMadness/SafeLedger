{
  "name": "safe-ledger",
  "productName": "SafeLedger",
  "version": "2.0.3",
  "description": "Free, offline and portable encrypted information vault",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },
  "repository": "https://github.com/MieleMadness/SafeLedger",
  "keywords": [
    "Electron",
    "SafeLedger",
    "portable",
    "offline",
    "encrypted-vault"
  ],
  "author": "SafeLedger contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.7"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "bootstrap": "3.4.1",
    "font-awesome": "4.7.0",
    "jquery": "3.7.1",
    "qrcode": "1.5.4"
  },
  "build": {
    "appId": "com.safeledger.app",
    "productName": "SafeLedger",
    "asar": true,
    "files": [
      "src/**/*",
      "sl.ico",
      "sl.png",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "sl.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SafeLedger-${version}-Portable.${ext}"
    }
  }
}
